# 별도 저장소로 관리되는 하위 프로젝트 (제외)
/Lifenology/
/gemini-live-api-examples/

# 비밀키
.env
**/.env
phone-stream/certs/

# 녹화물 (용량 큼)
phone-stream/recordings/

# 논문 등 부속 자료
*.pdf

# Python
__pycache__/
*.pyc
.venv/
venv/

# drone-agent-app 런타임 데이터
drone-agent-app/memory.json

# OS
.DS_Store

# 관리 콘솔 저장소 (서버별 상태 — 커밋하지 않음)
drone-agent-app/data/
drone-agent-app/config/

# 프런트엔드 빌드 산출물
node_modules/
dist/

# 계정별로 내보내지는 시나리오 파일 (런타임 산출물).
# 1번만 기본 시드로 커밋한다 — 새 계정은 여기서 복사되는 게 아니라
# agent/scenarios.py의 DEFAULT_SCENARIOS에서 시작한다.
drone-agent-app/agent/scenarios/*/
!drone-agent-app/agent/scenarios/1/

# 문서 변환 산출물
*.docx
